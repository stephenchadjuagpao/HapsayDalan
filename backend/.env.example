# Local development example
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_DB=hapsaydalan_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email recovery: configure SMTP to deliver verification codes.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_smtp_username
EMAIL_HOST_PASSWORD=your_smtp_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=HapsayDalan <noreply@yourdomain.com>
# Optional SMS verification for Philippine mobile numbers. Create an account,
# configure/verify a sender name, and add account credits at https://semaphore.co/.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDERNAME=
# Gmail example (replace the SMTP values above in your local .env):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=your-sender@gmail.com
# EMAIL_HOST_PASSWORD=your-google-app-password
# DEFAULT_FROM_EMAIL=HapsayDalan <your-sender@gmail.com>
# Use a Google App Password with 2-Step Verification enabled.
# Restart the backend after editing .env. Never commit your credentials.
FRONTEND_URL=http://localhost:3000
# For local HTTPS via the frontend proxy, bind Django to 127.0.0.1:8000:
# DJANGO_TRUST_HTTPS_PROXY=True

# Register a Google reCAPTCHA v2 "I'm not a robot" Checkbox key pair.
# The site key is public; keep the secret key in backend/.env only.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,127.0.0.1,192.168.5.52
# Detect this laptop's current LAN IPv4 addresses after changing Wi-Fi.
# Defaults to DEBUG; enable explicitly for a local HTTPS proxy with DEBUG=False.
DJANGO_AUTO_LAN_HOSTS=True
# For changing Wi-Fi IPs, disable domain validation ONCE in Google's reCAPTCHA
# Advanced Settings. Backend verification still checks configured/current hosts.
# HTTPS certificates must independently cover the address used in the browser.

# Maximum accepted reports per verified email in a rolling window.
REPORT_EMAIL_SUBMISSION_LIMIT=3
REPORT_EMAIL_SUBMISSION_WINDOW_SECONDS=600

# Production example
# Free Standard key: https://account.heigit.org/signup
# Kept server-side; shortest/fastest routes use openrouteservice and OSM data.
OPENROUTESERVICE_API_KEY=

