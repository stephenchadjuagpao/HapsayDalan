# Copy to deploy/.env on the server. Never commit deploy/.env.
SITE_DOMAIN=replace-with-your-public-domain.example
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=replace-with-your-public-domain.example
DJANGO_CORS_ALLOWED_ORIGINS=https://replace-with-your-public-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://replace-with-your-public-domain.example
FRONTEND_URL=https://replace-with-your-public-domain.example
POSTGRES_PASSWORD=replace-with-a-different-long-random-password

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-your-sender@gmail.com
EMAIL_HOST_PASSWORD=replace-with-your-gmail-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=replace-with-your-sender@gmail.com

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=replace-with-your-public-domain.example
OPENROUTESERVICE_API_KEY=
