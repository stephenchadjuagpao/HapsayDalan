# Copy to deploy/.env.cloud locally. Never upload the filled file to GitHub.
# Used only by scripts/cloud-manage.py for migration/verification from this laptop.
# Render automatically supplies its own RENDER_EXTERNAL_HOSTNAME.
RENDER_EXTERNAL_HOSTNAME=your-actual-service.onrender.com
DJANGO_SECRET_KEY=replace-with-the-cloud-secret-from-render
# Supabase Connect -> Session pooler, port 5432; URL-encode special password characters.
DATABASE_URL=postgresql://postgres.PROJECT:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
EVIDENCE_S3_ENDPOINT_URL=https://PROJECT.storage.supabase.co/storage/v1/s3
EVIDENCE_S3_REGION=copy-from-supabase-s3-settings
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
EVIDENCE_S3_BUCKET=evidence
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=HapsayDalan <your-verified-sender@example.com>
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
OPENROUTESERVICE_API_KEY=
